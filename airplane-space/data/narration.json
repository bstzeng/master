{
  "voice": "zh-TW-HsiaoChenNeural",
  "rate": "+0%",
  "scenes": [
    {
      "title": "飛機飛好高",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "飛機可以飛得好高好高。" },
        { "start": 4, "end": 8, "text": "那它能一直飛到太空嗎？" },
        { "start": 8, "end": 12, "text": "我們一起來看看！" }
      ]
    },
    {
      "title": "翅膀要靠空氣",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "飛機的翅膀，要靠空氣托著。" },
        { "start": 4, "end": 8, "text": "空氣推著翅膀往上抬。" },
        { "start": 8, "end": 12, "text": "沒有空氣，翅膀就沒用了。" }
      ]
    },
    {
      "title": "引擎要吸空氣",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "飛機的引擎會吸進空氣。" },
        { "start": 4, "end": 8, "text": "有空氣，燃料才能燒起來。" },
        { "start": 8, "end": 12, "text": "沒有空氣，引擎就熄火了。" }
      ]
    },
    {
      "title": "越高空氣越少",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "越往上，空氣越來越少。" },
        { "start": 4, "end": 8, "text": "飛機大約飛在十公里高。" },
        { "start": 8, "end": 12, "text": "太空在一百公里以上。" }
      ]
    },
    {
      "title": "太空幾乎沒有空氣",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "太空幾乎沒有空氣。" },
        { "start": 4, "end": 8, "text": "翅膀托不住，引擎吸不到。" },
        { "start": 8, "end": 12, "text": "所以飛機飛不到太空。" }
      ]
    },
    {
      "title": "火箭可以！",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "火箭自己帶著燃料和氧氣。" },
        { "start": 4, "end": 8, "text": "往下噴出熱氣，就能往上衝。" },
        { "start": 8, "end": 12, "text": "不靠空氣，也能飛上太空！" }
      ]
    },
    {
      "title": "一起記住",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "飛機靠空氣，火箭自己帶。" },
        { "start": 4, "end": 8, "text": "想知道火箭怎麼飛？" },
        { "start": 8, "end": 12, "text": "去看火箭的影片吧！" }
      ]
    }
  ]
}
