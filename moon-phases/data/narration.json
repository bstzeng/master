{
  "voice": "zh-TW-HsiaoChenNeural",
  "rate": "+0%",
  "scenes": [
    {
      "title": "月亮變變變",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "月亮有時圓圓，有時彎彎。" },
        { "start": 4, "end": 8, "text": "月亮真的會變形嗎？" },
        { "start": 8, "end": 12, "text": "其實月亮一直都是圓的！" }
      ]
    },
    {
      "title": "月亮不會發光",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "月亮自己不會發光。" },
        { "start": 4, "end": 8, "text": "太陽的光照在月亮上。" },
        { "start": 8, "end": 12, "text": "被照到的那一半會亮。" }
      ]
    },
    {
      "title": "月亮繞著地球轉",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "月亮繞著地球轉一大圈。" },
        { "start": 4, "end": 8, "text": "轉一圈大約一個月。" },
        { "start": 8, "end": 12, "text": "我們看它的角度一直變。" }
      ]
    },
    {
      "title": "從新月到滿月",
      "dur": 16,
      "subs": [
        { "start": 0, "end": 4, "text": "亮的一面背對我們，是新月。" },
        { "start": 4, "end": 8, "text": "看到一點點，是彎彎的眉月。" },
        { "start": 8, "end": 12, "text": "看到一半，叫做上弦月。" },
        { "start": 12, "end": 16, "text": "亮的一面全對著我們，是滿月！" }
      ]
    },
    {
      "title": "從滿月回到新月",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "滿月過後，亮的地方變少。" },
        { "start": 4, "end": 8, "text": "又剩一半，叫做下弦月。" },
        { "start": 8, "end": 12, "text": "最後又回到新月。" }
      ]
    },
    {
      "title": "在家試試看",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "拿一顆球和一盞燈。" },
        { "start": 4, "end": 8, "text": "拿著球轉圈圈，看亮的地方。" },
        { "start": 8, "end": 12, "text": "今晚一起看看月亮吧！" }
      ]
    }
  ]
}
