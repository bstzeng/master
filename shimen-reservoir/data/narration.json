{
  "voice": "zh-TW-HsiaoChenNeural",
  "rate": "+0%",
  "scenes": [
    {
      "title": "小水滴的旅行",
      "dur": 13,
      "subs": [
        { "start": 0, "end": 4.8, "text": "嗨！我是小水滴，我叫滴滴。" },
        { "start": 4.8, "end": 8.8, "text": "我們流進大漢溪，往下跑。" },
        { "start": 8.8, "end": 13, "text": "咦？前面有一道大牆！" }
      ]
    },
    {
      "title": "這裡是石門水庫",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "這道大牆叫做水壩。" },
        { "start": 4, "end": 8, "text": "水被擋下來，變成大大的湖。" },
        { "start": 8, "end": 12, "text": "這就是桃園的石門水庫！" }
      ]
    },
    {
      "title": "下大雨的時候",
      "dur": 13,
      "subs": [
        { "start": 0, "end": 4, "text": "颱風來了，雨下得好大。" },
        { "start": 4, "end": 8.5, "text": "水庫先把雨水存起來。" },
        { "start": 8.5, "end": 13, "text": "下游的家就不會淹水。" }
      ]
    },
    {
      "title": "水太滿了怎麼辦？",
      "dur": 16,
      "subs": [
        { "start": 0, "end": 4, "text": "雨一直下，水庫快裝滿了！" },
        { "start": 4, "end": 8, "text": "打開大水門，把水放出去。" },
        { "start": 8, "end": 12, "text": "這就叫做「洩洪」。" },
        { "start": 12, "end": 16, "text": "聽到警報，要離河邊遠遠的！" }
      ]
    },
    {
      "title": "沒下雨的時候",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "好久沒下雨，河水變少了。" },
        { "start": 4, "end": 8, "text": "水庫把存的水慢慢放出來。" },
        { "start": 8, "end": 12, "text": "大家就有水喝、有水洗澡。" }
      ]
    },
    {
      "title": "水還會做什麼",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "水往下衝，能轉動大輪子。" },
        { "start": 4, "end": 8, "text": "大輪子一轉，就能發電！" },
        { "start": 8, "end": 12, "text": "水也流到田裡，讓稻子長大。" }
      ]
    },
    {
      "title": "一起愛惜水",
      "dur": 12,
      "subs": [
        { "start": 0, "end": 4, "text": "水庫幫我們存水、防淹水。" },
        { "start": 4, "end": 8, "text": "我們一起節約用水！" },
        { "start": 8, "end": 12, "text": "下次去石門水庫看看吧！" }
      ]
    }
  ]
}
